# Основной сайт (Стройбиржа) — адрес вашего сервера (см. server/), необязателен для
# локальной разработки: без него приложение работает в демо-режиме (localStorage).
VITE_API_URL=http://localhost:8787
# Client ID приложения в oauth.yandex.ru — включает кнопку "Войти через Яндекс".
# Не секрет (client_secret прописывается только в server/.env, не здесь).
VITE_YANDEX_CLIENT_ID=

# Журнал объекта (/journal) — отдельный инструмент на Supabase, не связан с остальным сайтом.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Путь, по которому раздаётся приложение.
# Свой домен  -> не задавать (будет '/')
# GitHub Pages -> /raznorab/
# VITE_BASE_PATH=/raznorab/
