# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Supabase (тот же проект, что и у веб-приложения)
SUPABASE_URL=https://your-project.supabase.co
# service_role ключ из Settings -> API (НЕ anon-ключ, храните в секрете!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic API-ключ для разбора свободных сообщений ("купил цемент 5 мешков за 4500")
# Получить: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# Необязательно: модель для разбора текста (по умолчанию быстрая и дешёвая)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
