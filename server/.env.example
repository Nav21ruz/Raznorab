# Скопируйте в .env и заполните своими значениями.

# Два РАЗНЫХ пользователя к ОДНОЙ базе данных:
#   SERVICE_DATABASE_URL — тот, кто выполнял SQL-файлы (владелец схемы),
#     используется только для регистрации/входа.
#   APP_DATABASE_URL — обычный пользователь без особых прав, добавлен в
#     роль authenticated (grant authenticated to <имя>;). Все обычные
#     запросы идут через него — права на каждую строку решает сама база.
SERVICE_DATABASE_URL=postgres://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:6432/БАЗА?sslmode=verify-full
APP_DATABASE_URL=postgres://APP_ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:6432/БАЗА?sslmode=verify-full

# Любая длинная случайная строка (например, сгенерировать на randomkeygen.com)
JWT_SECRET=

# Из @BotFather в Telegram — нужен только для входа через Telegram Mini App.
# Если сайт нужен только как обычный веб-сайт — можно оставить пустым.
TELEGRAM_BOT_TOKEN=

PORT=8787
# Домен вашего сайта (без слэша на конце), например https://dumaev.ru
CORS_ORIGIN=

# Яндекс Object Storage (S3-совместимо) — для фото объявлений и портфолио
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Публичная ссылка на бакет, без слэша на конце
S3_PUBLIC_BASE_URL=https://storage.yandexcloud.net/ИМЯ_БАКЕТА
